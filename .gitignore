# ── Ignite Wax — .gitignore ─────────────────────────────────────────────

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — NEVER commit real secrets (.env.example is safe and tracked)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# ── sandbox / platform runtime (not part of the website repo) ───────────
/.zscripts/
/.z-ai-config
/.claude
/skills/
/examples/
/mini-services/
/tests/
/upload/
/db/
/data/order-counter.json
/download/
/worklog.md
/Caddyfile

# design / mockup generation scripts (sandbox only, not website code)
/scripts/
/tool-results/

# cloudflare
/.open-next/
/.wrangler/
