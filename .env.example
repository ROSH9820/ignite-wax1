# ── Ignite Wax — environment configuration ──────────────────────────────
# Copy to .env (local) or set in your Cloudflare dashboard (production).
# NEVER commit real secrets to git.

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://ignitewax.example.com

# Business email — receives order notifications (server-only)
BUSINESS_EMAIL=orders@ignitewax.example.com

# Public contact email shown on the contact page / footer
CONTACT_EMAIL=hello@ignitewax.example.com

# Resend (server-only) — https://resend.com/api-keys
# Until set, emails are logged to the server console instead of sent.
RESEND_API_KEY=
# Verified sender identity in Resend, e.g. "Ignite Wax <orders@ignitewax.com>"
EMAIL_FROM=

# WhatsApp number in international format, digits only (public)
# Example: 919876543210
NEXT_PUBLIC_BUSINESS_WHATSAPP_NUMBER=919999999999
# Legacy alias still supported as a fallback:
# NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# UPI configuration (server-only)
UPI_ID=ignitewax@upi
UPI_PAYEE_NAME=Ignite Wax
# Shown in the payment panel (public). Keep in sync with UPI_ID.
NEXT_PUBLIC_UPI_ID_DISPLAY=ignitewax@upi

# Optional anti-spam: Cloudflare Turnstile (server-only)
# ⚠️ DO NOT SET until the order form renders the Turnstile widget and sends
# the x-turnstile-token header. With a secret configured but no frontend
# widget, /api/order rejects EVERY submission (403). Keep commented out.
# TURNSTILE_SECRET_KEY=

# Admin dashboard password (server-only) — Phase 1 gate for /admin.
# Default if unset: ignite2026 — CHANGE THIS in production.
ADMIN_PASSWORD=ignite2026
